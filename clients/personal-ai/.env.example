# ============================================================
# Siyi Personal AI Workspace —— 环境变量示例
# 复制为 .env 后填入你自己的值。.env 已被 git 忽略，绝不入库。
# 注意：优先用「Demo Mode」对外演示（零依赖、无需任何 Key）：
#     从仓库根目录  npm run demo:web  →  http://localhost:8789
# 下面的配置只在你真正作为个人工作台「生产自用」时才需要。
# ============================================================

# ---- 运行模式 --------------------------------------------------
# personal（默认，使用你的个人 Obsidian/数据/Key）
# demo     使用仓库内的虚构演示数据（Nova Labs），配合同一套界面给第三方复现效果
APP_MODE=personal

# ---- LLM API Keys -------------------------------------------------
# 智谱 AI（主模型，至少填一个 Key 才能启用生产对话）
ZHIPU_API_KEY=your_zhipu_api_key_here
# DeepSeek（备用模型，可留空）
DEEPSEEK_API_KEY=
# 通义千问（备用模型，可留空）
QWEN_API_KEY=
# 硅基流动（Embedding 向量检索用；不启用向量检索可留空）
SILICONFLOW_API_KEY=

# ---- 模型（可选，默认 glm-4-flash）-------------------------------
AI_MODEL=glm-4-flash
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3
# 是否启用向量检索（true / false，默认按是否配置了 Embedding Key 自动判断）
RAG_USE_EMBEDDING=false

# ---- 本地数据源（个人工作台自用才需要；无则优雅降级为演示数据）
# Obsidian Vault 根目录
OBSIDIAN_VAULT_PATH=
# 提示词库目录
PROMPT_DIR=
# 复盘目录
REVIEW_DIR=

# ---- 生产后台 / 网站云函数（可选）-------------------------------
# 网站后台管理员密码
ADMIN_PASSWORD=
# Meet Siyi 公网云函数地址（从云端同步访客数据用）
CLOUD_API_BASE_URL=
CLOUD_ADMIN_PASSWORD=

# ---- 服务器 ----
PORT=8788
